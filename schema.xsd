<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="mod" type="ModType" />
    <xs:element name="map" type="MapType" />
    <xs:element name="card" type="CardType" />

    <xs:complexType name="ModType">
        <xs:sequence>
            <xs:element name="name" type="xs:string" />
            <xs:element name="author" type="xs:string" />
            <xs:element name="description" type="xs:string" />
            <xs:element name="version" type="xs:string" />
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="MapType">
        <xs:sequence>
            <xs:element name="name" type="xs:string" />
            <xs:element name="description" type="xs:string" />
            <xs:element name="files">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="floor" type="xs:string" />
                        <xs:element name="ceiling" type="xs:string" />
                        <xs:element name="material" type="xs:string" />
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="CardType">
        <xs:sequence>
            <xs:element name="name" type="xs:string" />
            <xs:element name="id" type="xs:ID" />
            <xs:element name="description" type="xs:string" />
            <xs:element name="image" type="xs:string" minOccurs="0" />
            <xs:element name="icon" type="xs:string" minOccurs="0" />
            <xs:element name="traits">
                <xs:complexType>
                    <xs:all>
                        <xs:element name="Speed" type="xs:decimal" minOccurs="0" />
                        <xs:element name="SpeedPercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="Acceleration" type="xs:decimal" minOccurs="0" />
                        <xs:element name="AccelerationPercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="Jumps" type="xs:decimal" minOccurs="0" />
                        <xs:element name="JumpsPercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="JumpForce" type="xs:decimal" minOccurs="0" />
                        <xs:element name="JumpForcePercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="Gravity" type="xs:decimal" minOccurs="0" />
                        <xs:element name="GravityPercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="MaxHealth" type="xs:decimal" minOccurs="0" />
                        <xs:element name="MaxHealthPercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="NumBullets" type="xs:decimal" minOccurs="0" />
                        <xs:element name="NumBulletsPercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="BulletBounces" type="xs:decimal" minOccurs="0" />
                        <xs:element name="BulletBouncesPercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="BulletSpread" type="xs:decimal" minOccurs="0" />
                        <xs:element name="BulletSpreadPercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="MaxAmmo" type="xs:decimal" minOccurs="0" />
                        <xs:element name="MaxAmmoPercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="BulletDamage" type="xs:decimal" minOccurs="0" />
                        <xs:element name="BulletDamagePercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="BulletSpeed" type="xs:decimal" minOccurs="0" />
                        <xs:element name="BulletSpeedPercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="BulletAttackSpeed" type="xs:decimal" minOccurs="0" />
                        <xs:element name="BulletAttackSpeedPercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="BulletReloadTime" type="xs:decimal" minOccurs="0" />
                        <xs:element name="BulletReloadTimePercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="BulletExplosionStacks" type="xs:decimal" minOccurs="0" />
                        <xs:element name="BulletExplosionStacksPercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="BulletFireStacks" type="xs:decimal" minOccurs="0" />
                        <xs:element name="BulletFireStacksPercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="BulletCryoStacks" type="xs:decimal" minOccurs="0" />
                        <xs:element name="BulletCryoStacksPercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="BulletGravity" type="xs:decimal" minOccurs="0" />
                        <xs:element name="BulletGravityPercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="GrenadeDamage" type="xs:decimal" minOccurs="0" />
                        <xs:element name="GrenadeDamagePercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="GrenadeRadius" type="xs:decimal" minOccurs="0" />
                        <xs:element name="GrenadeRadiusPercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="GrenadeCooldown" type="xs:decimal" minOccurs="0" />
                        <xs:element name="GrenadeCooldownPercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="GrenadeThrowSpeed" type="xs:decimal" minOccurs="0" />
                        <xs:element name="GrenadeThrowSpeedPercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="GrenadeRecursions" type="xs:decimal" minOccurs="0" />
                        <xs:element name="GrenadeRecursionsPercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="SpawnedRecursionGrenades" type="xs:decimal" minOccurs="0" />
                        <xs:element name="SpawnedRecursionGrenadesPercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="GrenadeFireStacks" type="xs:decimal" minOccurs="0" />
                        <xs:element name="GrenadeFireStacksPercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="GrenadeCryoStacks" type="xs:decimal" minOccurs="0" />
                        <xs:element name="GrenadeCryoStacksPercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="GrenadeGravity" type="xs:decimal" minOccurs="0" />
                        <xs:element name="GrenadeGravityPercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="GrenadeDamageDistanceExponent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="GrenadeDamageDistanceExponentPercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="GrenadeSpread" type="xs:decimal" minOccurs="0" />
                        <xs:element name="GrenadeSpreadPercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="GrenadeCount" type="xs:decimal" minOccurs="0" />
                        <xs:element name="GrenadeCountPercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="GrenadeTimer" type="xs:decimal" minOccurs="0" />
                        <xs:element name="GrenadeTimerPercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="ShieldEnergy" type="xs:decimal" minOccurs="0" />
                        <xs:element name="ShieldEnergyPercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="ShieldRechargeRate" type="xs:decimal" minOccurs="0" />
                        <xs:element name="ShieldRechargeRatePercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="ShieldBlockAmount" type="xs:decimal" minOccurs="0" />
                        <xs:element name="ShieldBlockAmountPercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="ShieldBashCost" type="xs:decimal" minOccurs="0" />
                        <xs:element name="ShieldBashCostPercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="ShieldLiftCost" type="xs:decimal" minOccurs="0" />
                        <xs:element name="ShieldLiftCostPercent" type="xs:decimal" minOccurs="0" />
                        <xs:element name="ShieldDrain" type="xs:decimal" minOccurs="0" />
                        <xs:element name="ShieldDrainPercent" type="xs:decimal" minOccurs="0" />
                    </xs:all>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
</xs:schema>